                        {
                            "type": "text",
                            "label": "Target user email",
                            "field": "target_user_email",
                            "help": "Email address of the user whose content you want to collect.",
                            "required": false
                        },
                        {
                            "type": "text",
                            "label": "Target chat ID",
                            "field": "target_chat_id",
                            "help": "ID of the chat whose content you want to collect.",
