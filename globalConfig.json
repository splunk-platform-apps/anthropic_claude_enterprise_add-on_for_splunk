{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "account",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "Compliance key type",
                                "field": "compliance_key_type"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Account Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of account name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "Account name.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Compliance API key",
                            "field": "compliance_api_key",
                            "help": "The Anthropic API key with the corresponding compliance scopes.",
                            "required": true,
                            "encrypted": true
                        },
                        {
                            "type": "singleSelect",
                            "label": "API Key Type",
                            "field": "compliance_key_type",
                            "defaultValue": "compliance_full",
                            "required": true,
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "compliance_full",
                                        "label": "Compliance Access Key"
                                    },
                                    {
                                        "value": "admin_activities_only",
                                        "label": "Admin API Key"
                                    }
                                ]
                            },
                            "help": "Select the key type. A Compliance Access Key (created in claude.ai) makes full use of the API, and the Admin API key (created in Claude Console) reaches the Activity Feed only. Compliance Access Key is required for directory and content inputs."
                        },
                        {
                            "type": "text",
                            "label": "Analytics API key",
                            "field": "analytics_api_key",
                            "help": "Provide an Analytics API key with the 'read:analytics' scope. If your Compliance API key already includes this scope, this field can be left empty. You may also use the same key for both fields if applicable.",
                            "required": false,
                            "encrypted": true
                        }
                    ],
                    "title": "Accounts"
                },
                {
                    "name": "logging",
                    "title": "Logging",
                    "entity": [
                        {
                            "type": "singleSelect",
                            "label": "Log level",
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "DEBUG",
                                        "label": "DEBUG"
                                    },
                                    {
                                        "value": "INFO",
                                        "label": "INFO"
                                    },
                                    {
                                        "value": "WARNING",
                                        "label": "WARNING"
                                    },
                                    {
                                        "value": "ERROR",
                                        "label": "ERROR"
                                    },
                                    {
                                        "value": "CRITICAL",
                                        "label": "CRITICAL"
                                    }
                                ]
                            },
                            "defaultValue": "INFO",
                            "field": "loglevel",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Log level must be one of: DEBUG, INFO, WARNING, ERROR, CRITICAL",
                                    "pattern": "^DEBUG|INFO|WARNING|ERROR|CRITICAL$"
                                }
                            ]
                        }
                    ]
                }
            ],
            "title": "Configuration"
        },
        "inputs": {
            "services": [
                {
                    "name": "compliance_activities",
                    "inputHelperModule": "compliance_activities_helper",
                    "title": "Compliance Activity Feed",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "field": "interval",
                            "label": "Interval",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Interval must be either a non-negative number, CRON interval or -1.",
                                    "pattern": "^((?:-1|\\d+(?:\\.\\d+)?)|(([\\*\\d{1,2}\\,\\-\\/]+\\s){4}[\\*\\d{1,2}\\,\\-\\/]+))$"
                                },
                                {
                                    "type": "number",
                                    "range": [
                                        30,
                                        86400
                                    ],
                                    "errorMsg": "Interval must be between 30 and 86400"
                                }
                            ],
                            "required": true,
                            "help": "Time interval of the data input, in seconds.",
                            "defaultValue": "60"
                        },
                        {
                            "type": "singleSelect",
                            "field": "index",
                            "label": "Index",
                            "defaultValue": "default",
                            "help": "Index where the data will be ingested.",
                            "options": {
                                "endpointUrl": "data/indexes?search=isInternal=0+disabled=0",
                                "denyList": "^_.*$",
                                "createSearchChoice": true
                            },
                            "validators": [
                                {
                                    "type": "index_name"
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account",
                            "options": {
                                "referenceName": "account"
                            },
                            "field": "account",
                            "help": "Account to use for this input.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Initial backfill days",
                            "field": "backfill_days",
                            "defaultValue": "7",
                            "help": "Days of activity to backfill on first run (max 90).",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Initial backfill days must be a non-negative number.",
                                    "pattern": "^((?:-1|\\d+(?:\\.\\d+)?)|(([\\*\\d{1,2}\\,\\-\\/]+\\s){4}[\\*\\d{1,2}\\,\\-\\/]+))$"
                                },
                                {
                                    "type": "number",
                                    "range": [
                                        1,
                                        90
                                    ],
                                    "errorMsg": "Backfill days must be between 1 and 90."
                                }
                            ],
                            "required": false
                        },
                        {
                            "type": "text",
                            "label": "Max events per cycle",
                            "field": "max_events_per_cycle",
                            "defaultValue": "1000",
                            "help": "Maximum number of events to fetch per cycle (max 1000).",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Max events per cycle must be a non-negative number.",
                                    "pattern": "^((?:-1|\\d+(?:\\.\\d+)?)|(([\\*\\d{1,2}\\,\\-\\/]+\\s){4}[\\*\\d{1,2}\\,\\-\\/]+))$"
                                },
                                {
                                    "type": "number",
                                    "range": [
                                        50,
                                        1000
                                    ],
                                    "errorMsg": "Max events per cycle must be between 50 and 1000"
                                }
                            ],
                            "required": false
                        }
                    ]
                },
                {
                    "name": "compliance_directory",
                    "inputHelperModule": "compliance_directory_helper",
                    "title": "Compliance Directory Sync",
                    "entity": [
                        {
                            "type": "text",
