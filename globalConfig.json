                                        {
                                            "fieldId": "target_user_email",
                                            "required": false,
                                            "display": false
                                        },
                                        {
                                            "fieldId": "target_chat_id",
                                            "required": true,
                                            "display": true
                                        },
                                        {
                                            "fieldId": "target_file_id",
                                            "required": false,
                                            "display": false
                                        },
                                        {
                                            "fieldId": "max_chats",
                                            "required": false,
                                            "display": true
                                        },
                                        {
                                            "fieldId": "include_messages",
                                            "required": false,
